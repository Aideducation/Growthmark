# Copy to .env.local and use the Web app configuration from Firebase Project settings.
# VITE_ variables are included in browser code. Never put private keys here.
VITE_USE_FIREBASE_EMULATORS=true
VITE_ENABLE_NUMBERED_INVOICES=false
# Local isolated invoice preview only; must be false for every production build.
VITE_INVOICE_CANDIDATE_PREVIEW=false
# Cloudflare production must explicitly set emulators=false, numbered invoices=true.
# Do not upload .env.local. See docs/release-runbook.md for server-only settings.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
